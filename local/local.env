# Entorno LOCAL de pruebas: PostgreSQL de la PC + PostgREST + Storage en disco.
# No contiene secretos reales; no se usa en producción.
PORT=3000
NODE_ENV=development
JWT_SECRET=secreto-local-solo-para-pruebas-practica-12
# Datos: directo al PostgreSQL de la PC (antes pasaban por PostgREST).
DATABASE_URL=postgres://postgres@127.0.0.1:5432/skondit_local
# Solo Storage: lo emula gateway.mjs.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=llave-local
ALLOWED_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200
