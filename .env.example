# ──────────────────────────────────────────
# SkonditBeats API — Variables de entorno
# Copia este archivo como .env y rellena los valores
# ──────────────────────────────────────────

# Servidor
PORT=3000
NODE_ENV=development

# JWT — genera un string aleatorio largo y seguro
# Puedes usar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_string_seguro_de_64_chars

# Supabase — los encuentras en: Project Settings → API
SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# CORS — URL de tu frontend en Vercel (y localhost para desarrollo)
ALLOWED_ORIGINS=http://localhost:4200,https://tu-app.vercel.app

# Frontend — usado por el callback de Google para redirigir tras el login
FRONTEND_URL=https://tu-app.vercel.app

# Email OTP — usa Brevo (https://brevo.com) para enviar códigos de verificación
BREVO_API_KEY=cambia_esto_por_tu_api_key_de_brevo
EMAIL_FROM=SkonditBeats
EMAIL_SENDER=cambia_por_un_remitente_verificado@tudominio.com

# (Opcional) Desvía todos los correos a un email fijo durante desarrollo
DEV_EMAIL_TO=tu_correo@example.com
